+// (?portrait=off: none; hide: made, never shown; only:K one kind alone; gov: the frames' governor on
+// in a test too; any of BUDGETS' own, as slots:16,closes:0 - for the tests)
+function modeOf() {
+  const o = { off: false, hide: false, only: -1, gov: false, over: {} };
+  const q = typeof location !== 'undefined' ? new URLSearchParams(location.search) : null;
+  const v = q && q.get('portrait');
+  if (v) {
+    for (const p of v.split(',')) {
