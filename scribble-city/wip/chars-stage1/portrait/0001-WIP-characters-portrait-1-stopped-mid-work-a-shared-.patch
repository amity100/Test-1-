diff --git a/scribble-city/v5/bench/portraits.js b/scribble-city/v5/bench/portraits.js
new file mode 100644
index 0000000..3f82d6a
--- /dev/null
+++ b/scribble-city/v5/bench/portraits.js
@@ -0,0 +1,137 @@
+import * as THREE from 'three';
+import { shared, pens, makeSurface, LAYERS } from '../js/render/materials.js';
+import { Pipeline } from '../js/render/pipeline.js';
+import { FigureRenderer } from '../js/game/figure.js';
+import { Doodle } from '../js/game/doodle.js';
+import { folkLook } from '../js/game/looks.js';
+import { DayNight } from '../js/game/daynight.js';
+import { initProvoke } from '../js/render/provoke.js';
+import { cacheUniformArrays } from '../js/render/glcache.js';
+import { FOLK } from '../js/render/folkspec.js';
+
+// (v5, ROADMAP 14.1) A bench for the portraits (render/portraits.js): the city's people standing on
+// a plain lawn in the afternoon light, drawn exactly as the game draws them (its pipeline, its
+// people's renderer, their rig), and nothing else of the city - it loads in seconds. For the tests:
+//   window.__bench.place([[kind, x, z, yaw], ...], { hold })   people (hold: a face held as asked -
+//                                                              { expr, k } - drawn as a portrait
+//                                                              whatever the distance)
+//   window.__bench.cam([x, y, z], [x, y, z], fov)              the camera
+//   window.__bench.head(i)                                     person i's head's middle
+//   window.__frame(n, dt)                                      n steps, one picture
+// ?low: a phone's budget; ?portrait=...: render/portraits.js
+
+const params = new URLSearchParams(location.search);
+const low = params.has('low');
+const renderer = new THREE.WebGLRenderer({ antialias: false, preserveDrawingBuffer: true });
+renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2));
+renderer.setSize(window.innerWidth, window.innerHeight);
+renderer.setClearColor(0x000000, 0);
+document.getElementById('viewport').appendChild(renderer.domElement);
+const gl = renderer.getContext();
+initProvoke(gl, false);
+cacheUniformArrays(gl);
+shared.uQuality.value = low ? 0 : 1;
+const scene = new THREE.Scene();
+const camera = new THREE.PerspectiveCamera(40, window.innerWidth / window.innerHeight, 0.05, 400);
+camera.rotation.order = 'YXZ';
+const pipe = new Pipeline(renderer, scene, camera, { low });
+pipe.scale = 1;
+pipe.defaultScale = 1;
+pipe.minScale = 1;
+pipe.maxScale = 1;
+shared.uPR.value = pipe.pixelsPerCss;
+pens.can = pipe.hdr && !params.has('onepass') && gl.getParameter(gl.MAX_DRAW_BUFFERS) >= 6 && gl.getParameter(gl.MAX_COLOR_ATTACHMENTS) >= 6;
+pipe.pensMode = pens.can ? 'two' : 'one';
+pipe.setPens(pens.can && !low);
+pipe.depthFirst = false;
+pipe.depthFixed = true;
+// a lawn, and a wall far behind (something for the light and the pens to fall on)
+const lawn = new THREE.Mesh(new THREE.PlaneGeometry(120, 120).rotateX(-Math.PI / 2), makeSurface({ kind: 'ground', color: new THREE.Color(0.42, 0.62, 0.3) }));
+scene.add(lawn);
+const wall = new THREE.Mesh(new THREE.BoxGeometry(60, 6, 0.4).translate(0, 3, -14), makeSurface({ kind: 'wall', color: new THREE.Color(0.86, 0.8, 0.7) }));
+scene.add(wall);
+const game = { params, pipe, world: null, weather: null };
+const day = new DayNight(game);
+day.setHour(params.has('hour') ? +params.get('hour') : 14.5);
+const fr = new FigureRenderer(scene);
+const bodies = fr.bodies;
+bodies.setRenderer(renderer);
+bodies.setPortraitBudget(low ? 'phone' : 'desktop');
+bodies.lodFar = low ? 32 : 55;
+let people = [];
+let time = 0;
+const center = new THREE.Vector3();
+
+function place(list, o = {}) {
+  for (const p of people) p.fig.dispose();
+  people = list.map(([k, x, z, yaw], i) => {
+    const fig = new Doodle(fr, folkLook(k), { seed: 11 + i * 7.3 });
+    fig.pos.set(x, 0, z);
+    fig.yaw = yaw || 0;
+    fig.speed = 0;
+    fig.lookAt = null;
+    if (o.hold) fig.__portrait = { expr: o.hold.expr || 'neutral', k: o.hold.k === undefined ? 1 : o.hold.k, au: o.hold.au || {} };
+    return { k, fig };
+  });
+  return people.length;
+}
+
+function cam(pos, look, fov) {
+  camera.position.set(pos[0], pos[1], pos[2]);
+  camera.lookAt(look[0], look[1], look[2]);
+  if (fov) camera.fov = fov;
+  camera.aspect = window.innerWidth / window.innerHeight;
+  camera.updateProjectionMatrix();
+  camera.updateMatrixWorld();
+}
+
+function step(dt) {
+  time += dt;
+  shared.uTime.value = time;
+  camera.updateMatrixWorld();
+  fr.begin(camera);
+  for (const p of people) {
+    p.fig.update(dt);
+    p.fig.draw(camera.position);
+  }
+  fr.end();
+}
+
+function frame(n = 1, dt = 1 / 30) {
+  for (let i = 0; i < n; i++) step(dt);
+  center.copy(camera.position);
+  pipe.render(center);
+  pipe.syncGpu();
+  renderer.setRenderTarget(null);
+  return true;
+}
+
+function head(i) {
+  const f = people[i] && people[i].fig;
+  if (!f) return null;
+  const h = f.j.headC;
+  const v = h.clone().project(camera);
+  return { x: h.x, y: h.y, z: h.z, sx: (v.x * 0.5 + 0.5) * window.innerWidth, sy: (0.5 - v.y * 0.5) * window.innerHeight };
+}
+
+cam([0, 1.6, 3], [0, 1.5, 0], 40);
+place([]);
+window.__bench = { place, cam, frame, head, people: () => people, bodies, pipe, renderer, scene, camera, FOLK, step };
+window.__frame = frame;
+window.addEventListener('resize', () => {
+  renderer.setSize(window.innerWidth, window.innerHeight);
+  camera.aspect = window.innerWidth / window.innerHeight;
+  camera.updateProjectionMatrix();
+});
+// (every shader made before the first picture, as the game does)
+const progs = pipe.precompile();
+(async () => {
+  const t0 = performance.now();
+  if (renderer.extensions.has('KHR_parallel_shader_compile')) {
+    while (progs.some((p) => !p.isReady()) && performance.now() - t0 < 60000) await new Promise((r) => setTimeout(r, 50));
+  }
+  frame(1);
+  window.__ready = true;
+  document.getElementById('info').textContent = `ספסל הפורטרטים · ${progs.length} shaders`;
+})();
+void LAYERS;
