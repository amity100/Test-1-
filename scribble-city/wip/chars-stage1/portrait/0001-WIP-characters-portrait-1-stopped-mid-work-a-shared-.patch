+
+// ------------------------------------------------------------------ how the light falls as it moves
+// Every point's normal as each of the face's moves makes it (at its full), less its normal at rest:
+// a head moved by a move, its normals worked out again - as three.js does (the triangles' sides
+// crossed, so a bigger triangle counts for more, summed at their corners) - but only round the
+// points that move: a move moves a few hundred of the head's thousands. pos: the head at rest (nt
+// points), idx: its triangles, dp: each move's moves of its points (na moves, nt points, 3 each)
+export class NormalMoves {
+  constructor(idx, nt, dp, na) {
+    this.idx = idx;
+    this.nt = nt;
+    this.na = na;
+    this.dp = dp;
+    const T = idx.length / 3;
+    // (which triangles each move moves, and the points they have)
+    const moved = new Uint8Array(nt);
+    const mark = new Int32Array(nt).fill(-1);
+    this.tris = [];
+    this.pts = [];
+    for (let c = 0; c < na; c++) {
+      moved.fill(0);
+      const o = c * nt * 3;
+      for (let i = 0; i < nt; i++) if (dp[o + i * 3] || dp[o + i * 3 + 1] || dp[o + i * 3 + 2]) moved[i] = 1;
+      const tl = [];
+      const pl = [];
+      for (let t = 0; t < T; t++) {
+        const a = idx[t * 3];
+        const b = idx[t * 3 + 1];
+        const d = idx[t * 3 + 2];
+        if (!(moved[a] || moved[b] || moved[d])) continue;
+        tl.push(t);
+        for (const v of [a, b, d]) {
+          if (mark[v] === c) continue;
+          mark[v] = c;
+          pl.push(v);
+        }
+      }
+      this.tris.push(Int32Array.from(tl));
+      this.pts.push(Int32Array.from(pl));
+    }
+    this.sum = new Float64Array(nt * 3);
+    this.tmp = new Float64Array(nt * 3);
+    this.cr = new Float64Array(T * 3);
+  }
+
+  // the normals at rest of the head at pos (unit; and their sums kept for the moves)
+  rest(pos, out) {
+    const idx = this.idx;
+    const S = this.sum;
+    const cr = this.cr;
+    S.fill(0);
+    for (let t = 0; t < idx.length / 3; t++) {
+      const a = idx[t * 3] * 3;
+      const b = idx[t * 3 + 1] * 3;
+      const c = idx[t * 3 + 2] * 3;
+      // (three.js: (c - b) x (a - b))
+      const ux = pos[c] - pos[b];
+      const uy = pos[c + 1] - pos[b + 1];
+      const uz = pos[c + 2] - pos[b + 2];
+      const vx = pos[a] - pos[b];
+      const vy = pos[a + 1] - pos[b + 1];
+      const vz = pos[a + 2] - pos[b + 2];
+      const nx = uy * vz - uz * vy;
+      const ny = uz * vx - ux * vz;
+      const nz = ux * vy - uy * vx;
+      cr[t * 3] = nx;
+      cr[t * 3 + 1] = ny;
+      cr[t * 3 + 2] = nz;
+      for (const v of [a, b, c]) {
+        S[v] += nx;
+        S[v + 1] += ny;
+        S[v + 2] += nz;
+      }
+    }
+    for (let i = 0; i < this.nt; i++) {
+      const l = Math.hypot(S[i * 3], S[i * 3 + 1], S[i * 3 + 2]) || 1;
+      out[i * 3] = S[i * 3] / l;
+      out[i * 3 + 1] = S[i * 3 + 1] / l;
+      out[i * 3 + 2] = S[i * 3 + 2] / l;
+    }
+    return out;
+  }
+
+  // move c's normal moves of the head at pos (rest() first, for the same pos), into each(i, dx, dy,
+  // dz) for every point whose normal it moves
+  move(pos, nrm, c, each) {
+    const idx = this.idx;
+    const S = this.sum;
+    const Q = this.tmp;
+    const cr = this.cr;
+    const dp = this.dp;
+    const o = c * this.nt * 3;
+    const pl = this.pts[c];
+    for (let k = 0; k < pl.length; k++) {
+      const v = pl[k] * 3;
+      Q[v] = S[v];
+      Q[v + 1] = S[v + 1];
+      Q[v + 2] = S[v + 2];
+    }
+    const tl = this.tris[c];
+    for (let k = 0; k < tl.length; k++) {
+      const t = tl[k];
+      const a = idx[t * 3] * 3;
+      const b = idx[t * 3 + 1] * 3;
+      const d = idx[t * 3 + 2] * 3;
+      const ax = pos[a] + dp[o + a];
+      const ay = pos[a + 1] + dp[o + a + 1];
+      const az = pos[a + 2] + dp[o + a + 2];
+      const bx = pos[b] + dp[o + b];
+      const by = pos[b + 1] + dp[o + b + 1];
+      const bz = pos[b + 2] + dp[o + b + 2];
+      const ux = pos[d] + dp[o + d] - bx;
+      const uy = pos[d + 1] + dp[o + d + 1] - by;
+      const uz = pos[d + 2] + dp[o + d + 2] - bz;
+      const vx = ax - bx;
+      const vy = ay - by;
+      const vz = az - bz;
+      const nx = uy * vz - uz * vy - cr[t * 3];
+      const ny = uz * vx - ux * vz - cr[t * 3 + 1];
+      const nz = ux * vy - uy * vx - cr[t * 3 + 2];
+      for (const v of [a, b, d]) {
+        Q[v] += nx;
+        Q[v + 1] += ny;
+        Q[v + 2] += nz;
+      }
+    }
+    for (let k = 0; k < pl.length; k++) {
+      const v = pl[k] * 3;
+      const l = Math.hypot(Q[v], Q[v + 1], Q[v + 2]) || 1;
+      each(pl[k], Q[v] / l - nrm[v], Q[v + 1] / l - nrm[v + 1], Q[v + 2] / l - nrm[v + 2]);
+    }
+  }
+
+  // every move's normal moves of the head at pos, as the shader reads them (render/glsl.js PORTRAIT:
+  // a texel each, move after move, W a row)
+  all(pos, W) {
+    const nt = this.nt;
+    const rows = Math.ceil((this.na * nt) / W);
+    const out = new Float32Array(W * rows * 4);
+    const nrm = this.rest(pos, new Float32Array(nt * 3));
+    for (let c = 0; c < this.na; c++) {
+      this.move(pos, nrm, c, (i, x, y, z) => {
+        const t = (c * nt + i) * 4;
+        out[t] = x;
+        out[t + 1] = y;
+        out[t + 2] = z;
+      });
+    }
+    return { data: out, W, rows };
+  }
+
+  // (ROADMAP 14.1) the head of one of the city's people (pos) against the base head's normal moves
+  // (base, as all() gave them): wherever theirs turn a normal more than lim degrees from where the
+  // base's would (at any move's full - an eyelid shut over a rounder eye, the nose's wings on a
+  // broader nose), that point's own moves, all of them - the rest of the head shares the base's.
+  // fix: for each point, its row + 1 (0: the base's); data: a texel a move, row after row
+  fixes(pos, base, W, lim = 2) {
+    const nt = this.nt;
+    const na = this.na;
+    const nrm = this.rest(pos, new Float32Array(nt * 3));
+    const own = new Float32Array(na * nt * 3);
+    const bad = new Uint8Array(nt);
+    const cosL = Math.cos((lim * Math.PI) / 180);
+    for (let c = 0; c < na; c++) {
+      this.move(pos, nrm, c, (i, x, y, z) => {
+        const o = (c * nt + i) * 3;
+        own[o] = x;
+        own[o + 1] = y;
+        own[o + 2] = z;
+        if (bad[i]) return;
+        const t = (c * nt + i) * 4;
+        const ax = nrm[i * 3] + x;
+        const ay = nrm[i * 3 + 1] + y;
+        const az = nrm[i * 3 + 2] + z;
+        const bx = nrm[i * 3] + base[t];
+        const by = nrm[i * 3 + 1] + base[t + 1];
+        const bz = nrm[i * 3 + 2] + base[t + 2];
+        const l = Math.hypot(ax, ay, az) * Math.hypot(bx, by, bz);
+        // (a point with no normal of its own - the tongue's tip, where its triangles meet in one: none)
+        if (l < 1e-8) return;
+        if ((ax * bx + ay * by + az * bz) / l < cosL) bad[i] = 1;
+      });
+    }
+    let n = 0;
+    const fix = new Float32Array(nt);
+    for (let i = 0; i < nt; i++) if (bad[i]) fix[i] = ++n;
+    const rows = Math.max(1, Math.ceil((n * na) / W));
+    const data = new Float32Array(W * rows * 4);
+    for (let i = 0; i < nt; i++) {
+      if (!fix[i]) continue;
+      const f = fix[i] - 1;
+      for (let c = 0; c < na; c++) {
+        const o = (c * nt + i) * 3;
+        const t = (f * na + c) * 4;
+        data[t] = own[o];
+        data[t + 1] = own[o + 1];
+        data[t + 2] = own[o + 2];
+      }
+    }
+    return { fix, data, W, rows, n };
+  }
+}
