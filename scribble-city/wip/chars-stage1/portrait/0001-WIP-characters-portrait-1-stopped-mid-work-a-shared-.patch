+      if (held) {
+        sc -= 0.75;
+        if (now - held.since < 0.5) sc -= 3;
+      }
+      c.s = sc;
+    }
+    // (in order, in place)
+    for (let i = 1; i < n; i++) {
+      const c = cand[i];
+      let j = i - 1;
+      while (j >= 0 && cand[j].s > c.s) {
+        cand[j + 1] = cand[j];
+        j--;
+      }
+      cand[j + 1] = c;
+    }
+    let w = 0;
+    for (; w < n && w < S; w++) {
+      const c = cand[w];
+      if (c.s === Infinity) break;
+      c.fig.__pwin = F;
+      const K = this.kinds[c.k];
+      // (whose picture is not there yet: painted next)
+      if (!K.ready) this.want[c.k] = -1;
+      else K.lastUsed = now;
+    }
+    // those who had one and are no longer among them: faded out; those fading out who are again:
+    // faded back in, as there is room
+    for (const s of this.slots) {
+      if (s.fig && s.dir > 0 && s.fig.__pwin !== F) {
+        s.dir = -1;
+        active--;
+      }
+    }
+    for (const s of this.slots) {
+      if (s.fig && s.dir < 0 && s.fig.__pwin === F && active < S) {
+        s.dir = 1;
+        active++;
+      }
+    }
+    // and the new ones
+    for (let i = 0; i < w && active < S; i++) {
+      const c = cand[i];
+      const fig = c.fig;
+      if (fig.__pslot && fig.__pslot.fig === fig) continue;
+      const K = this.kinds[c.k];
+      if (!K.ready) continue;
+      let slot = null;
+      for (const s of this.slots) {
+        if (!s.fig) {
+          slot = s;
+          break;
+        }
+      }
+      if (!slot) break;
+      const face = fig.__face || (fig.__face = new PortraitFace(fig.seed || 0));
+      // (a face drawn this way again after a while: as it is now, not eased from how it was)
+      if (face.lastT < 0 || now - face.lastT > 0.5) face.fresh = true;
+      slot.bind(K, fig, face, now);
+      slot.seen = F;
+      fig.__pslot = slot;
+      active++;
+      K.lastUsed = now;
+    }
+    for (let i = 0; i < n; i++) cand[i].fig = null;
+    this.nc = 0;
+    // a close look (the face lab's; a face filling a good part of the screen a little while): the
+    // closer picture, once it is there
+    for (const s of this.slots) {
+      if (!s.fig) continue;
+      s.nearT = s.px > B.closePx ? s.nearT + dt : 0;
+      const K = s.kind;
+      const close = !!s.fig.__portrait || s.nearT > 0.5;
+      if (close) K.closeWant = Math.max(K.closeWant || 0, now + 1);
+      const p = close && K.close ? K.close : K.pic;
+      if (p === K.close) K.closeUsed = now;
+      if (s.pic !== p) s.setPicture(p);
+    }
+    this.pump(now, atlasBusy);
+    this.want.fill(Infinity);
+  }
+
+  // the helper's next picture: the face lab's close one first, then the nearest kind's who has none
+  pump(now, atlasBusy) {
+    if (!this.worker || this.busy) return;
+    if (this.sys.length) {
+      this.post(this.sys.shift());
+      return;
+    }
+    // (a phone's helpers: one at a time - the city's people's own pictures first, render/heroart.js)
+    if (this.touch && atlasBusy) return;
+    const B = this.B;
+    const kit = this.kit;
+    const K = this.kinds;
+    // a close picture
+    let cl = null;
+    for (const k of K) if (k && this.allowed(k.k) && k.closeWant > now && !k.close && !k.closeJob && k.pic && (!cl || k.closeWant > cl.closeWant)) cl = k;
+    if (cl) {
+      let has = 0;
+      let old = null;
+      for (const k of K) {
+        if (!k || !k.close) continue;
+        has++;
+        if (now - k.closeUsed > 2 && (!old || k.closeUsed < old.closeUsed)) old = k;
+      }
+      if (has >= B.closes && old) {
+        PortraitKind.drop(old.close);
+        old.close = null;
+        has--;
+      }
+      if (has < B.closes) {
+        this.paint(cl, true);
+        return;
+      }
+    }
+    // the nearest kind wanted with no picture
+    let best = null;
+    for (const k of K) {
+      if (!k || k.pic || k.jobs || !this.allowed(k.k) || (k.failed || 0) > 2) continue;
+      const d = this.want[k.k];
+      if (d === Infinity) continue;
+      if (!best || d < this.want[best.k]) best = k;
+    }
+    if (!best) return;
+    let held = 0;
+    for (const k of K) if (k && (k.pic || k.jobs)) held++;
+    if (held >= B.kinds) {
+      // (room made: the kind longest unseen and not wanted now - or, for a kind wanted nearer, the
+      // one wanted farthest)
+      let out = null;
+      for (const k of K) {
+        if (!k || !k.pic || k.users > 0) continue;
+        if (this.want[k.k] === Infinity) {
+          if (!out || this.want[out.k] !== Infinity || k.lastUsed < out.lastUsed) out = k;
+        } else if (this.want[k.k] > this.want[best.k] + 5 && (!out || (this.want[out.k] !== Infinity && this.want[k.k] > this.want[out.k]))) out = k;
+      }
+      if (!out) return;
+      this.evict(out);
+    }
+    this.paint(best, false);
+  }
+
+  paint(K, close) {
+    const w = close ? this.B.close : this.B.pic;
+    const H = Math.round(w * ASPECT);
+    const h = Math.min(H, Math.ceil((1 - this.kit.picV0) * H));
+    const msg = { art: 'portrait', folk: K.k, w, H, h, seed: 7, W: AUW, close };
+    const tr = [];
+    if (!K.fixed && !close) {
+      msg.pos = K.rest();
+      tr.push(msg.pos.buffer);
+    }
+    if (close) K.closeJob = true;
+    else K.jobs = 1;
+    this.post(msg, tr);
+  }
+
+  evict(K) {
+    PortraitKind.drop(K.pic);
+    PortraitKind.drop(K.close);
+    K.pic = null;
+    K.close = null;
+    K.dropFix();
+    this.stats.evicted++;
+  }
+
+  // (the frames' governor: frames slower than they should be for a few seconds - one portrait fewer
+  // for a while; quick again - one more. Not in the tests, whose frames are as slow as they come)
+  govern() {
+    if (this.mode.test && !this.mode.gov) return;
+    const t = performance.now();
+    const ms = t - (this.ftAt || t);
+    this.ftAt = t;
+    if (ms <= 0 || ms > 1000) return;
+    this.ft[this.ftN++ % this.ft.length] = ms;
+    if (this.ftN < this.ft.length || this.ftN % 30) return;
+    this.ftS.set(this.ft);
+    this.ftS.sort();
+    const med = this.ftS[this.ft.length >> 1];
+    const B = this.B;
+    if (med > B.frameMs * 1.15 && this.S > B.minSlots && t > this.govAt) {
+      this.S--;
+      this.govAt = t + 10000;
+    } else if (med < B.frameMs * 0.9 && this.S < B.slots && t > this.govAt) {
+      this.S++;
+      this.govAt = t + 10000;
+    }
+  }
+
+  // (the tests)
+  count() {
+    let n = 0;
+    for (const s of this.slots) if (s.fig && s.seen === this.frame) n++;
+    return n;
+  }
+
+  debug() {
+    const K = this.kinds.filter((k) => k && (k.pic || k.jobs));
+    return {
+      budget: this.budgetName,
+      S: this.S,
+      ready: this.kit.ready,
+      kinds: K.map((k) => `${k.k}${k.pic ? '' : '…'}${k.close ? '+' : ''}${k.fixTex ? `f${k.fixTex.image.height}` : ''}`).join(' '),
+      slots: this.slots.filter((s) => s.fig).map((s) => `${s.kind.k}:${s.fade.toFixed(2)}${s.dir < 0 ? 'v' : ''}${s.pic === s.kind.close ? 'C' : ''}`).join(' '),
+      stats: this.stats,
+    };
+  }
+}
