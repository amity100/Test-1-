{
  "name": "hahitpashtut",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "node scripts/words.mjs && npm run open && npm run effect && npm run answer && npm run alive && npm run balance && tsc && vite build && node scripts/inline.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "phone": "node scripts/check-phone.mjs",
    "open": "esbuild scripts/check-open.ts --bundle --platform=node --format=esm --outfile=node_modules/.open.mjs --external:three && node node_modules/.open.mjs",
    "alive": "esbuild scripts/check-alive.ts --bundle --platform=node --format=esm --outfile=node_modules/.alive.mjs --external:three && node node_modules/.alive.mjs",
    "balance": "esbuild scripts/check-balance.ts --bundle --platform=node --format=esm --outfile=node_modules/.balance.mjs --external:three && node node_modules/.balance.mjs",
    "effect": "esbuild scripts/check-effect.ts --bundle --platform=node --format=esm --outfile=node_modules/.effect.mjs --external:three && node node_modules/.effect.mjs",
    "answer": "esbuild scripts/check-answer.ts --bundle --platform=node --format=esm --outfile=node_modules/.answer.mjs --external:three && node node_modules/.answer.mjs"
  },
  "dependencies": {
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@types/three": "^0.169.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "esbuild": "^0.24.0"
  }
}
